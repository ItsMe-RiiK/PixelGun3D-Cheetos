root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{json,html,yml,xml,js}]
indent_style = tab
indent_size = 2

[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 2

[*.{py,sh,bat}]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 4
